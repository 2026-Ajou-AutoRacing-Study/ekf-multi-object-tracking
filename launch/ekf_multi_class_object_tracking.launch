<launch>
  <arg name="fast_confirmed_vehicle_promotion" default="false"/>
  <arg name="pedestrian_gaussian_association_ranking" default="false"/>
  <arg name="vehicle_promotion_min_confidence" default="0.60"/>
  <arg name="input_objects"
       default="/perception/object_recognition/detection/objects"/>
  <arg name="output_objects"
       default="/perception/object_recognition/tracking/objects"/>
  <arg name="world_frame_id" default="map"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="time_aware_track_lifecycle" default="true"/>
  <arg name="confirmed_track_max_coast_time_sec" default="0.50"/>
  <arg name="confirmed_stationary_track_max_coast_time_sec" default="1.00"/>
  <arg name="lifecycle_stationary_speed_threshold_mps" default="2.0"/>
  <arg name="suppress_duplicate_track_birth" default="true"/>
  <arg name="duplicate_birth_suppression_distance_m" default="0.75"/>
  <arg name="duplicate_birth_minimum_max_dimension_m" default="1.0"/>
  <arg name="duplicate_birth_maximum_dimension_ratio" default="2.0"/>
  <arg name="canonicalize_vehicle_orientation_to_motion" default="true"/>
  <arg name="orientation_canonicalization_min_speed_mps" default="1.0"/>
  <arg name="orientation_flip_enter_error_deg" default="100.0"/>
  <arg name="orientation_flip_exit_error_deg" default="80.0"/>
  <arg name="compensate_output_to_current_time" default="false"/>
  <arg name="hold_unknown_output_pose" default="false"/>
  <arg name="stationary_unknown_prediction" default="false"/>
  <arg name="maximum_output_compensation_sec" default="0.25"/>
  <arg name="fixed_output_rate_hz" default="0.0"/>
  <arg name="maximum_fixed_output_prediction_age_sec" default="0.25"/>
  <arg name="detection_velocity_fusion_mode" default="0"/>
  <arg name="detection_velocity_noise_std_mps" default="1.0"/>
  <arg name="detection_velocity_update_max_track_age_sec" default="1.0"/>
  <arg name="detection_velocity_maximum_output_age_sec" default="0.25"/>
  <arg name="detection_velocity_max_longitudinal_innovation_mps" default="5.0"/>
  <arg name="detection_velocity_longitudinal_blend" default="1.0"/>
  <arg name="center_motion_velocity_fusion" default="false"/>
  <arg name="publish_center_motion_diagnostics" default="false"/>
  <arg name="publish_association_diagnostics" default="false"/>
  <arg name="diagnostics_auto_on_subscribe" default="true"/>
  <arg name="shape_consistent_association_ranking" default="false"/>
  <arg name="guard_inconsistent_class_transitions" default="false"/>
  <arg name="association_diagnostics_topic"
       default="/perception/object_recognition/tracking/diagnostics/association"/>
  <arg name="center_motion_active_objects"
       default="/perception/object_recognition/tracking/center_motion_active_objects"/>
  <arg name="center_motion_inactive_objects"
       default="/perception/object_recognition/tracking/center_motion_inactive_objects"/>
  <arg name="center_motion_fuse_ekf_state" default="true"/>
  <arg name="center_motion_override_output_velocity" default="false"/>
  <arg name="center_motion_maximum_output_age_sec" default="0.40"/>
  <arg name="center_motion_min_baseline_sec" default="0.30"/>
  <arg name="center_motion_medium_baseline_sec" default="0.65"/>
  <arg name="center_motion_long_baseline_sec" default="0.90"/>
  <arg name="center_motion_max_gap_sec" default="0.25"/>
  <arg name="center_motion_min_update_interval_sec" default="0.20"/>
  <arg name="center_motion_max_fit_residual_m" default="0.10"/>
  <arg name="center_motion_early_noise_std_mps" default="1.50"/>
  <arg name="center_motion_mature_noise_std_mps" default="0.60"/>
  <!-- Position-only tracker tuning knobs. Defaults preserve production. -->
  <arg name="prediction_model" default="1"/>
  <arg name="system_noise_std_vx_vy_ms" default="1.0"/>
  <arg name="meas_noise_std_xy_m" default="0.4"/>
  <arg name="meas_noise_std_yaw_deg" default="10.0"/>
  <arg name="use_kinematic_model" default="false"/>

  <rosparam file="$(env AJOUNICE_ROOT)/base_ws/src/ekf-multi-object-tracking/config/config.yaml" command="load"/>
  <param name="configure/pedestrian_gaussian_association_ranking"
         value="$(arg pedestrian_gaussian_association_ranking)"/>
  <param name="configure/fast_confirmed_vehicle_promotion"
         value="$(arg fast_confirmed_vehicle_promotion)"/>
  <param name="configure/vehicle_promotion_min_confidence"
         value="$(arg vehicle_promotion_min_confidence)"/>
  <param name="configure/canonicalize_vehicle_orientation_to_motion"
         value="$(arg canonicalize_vehicle_orientation_to_motion)"/>
  <param name="configure/orientation_canonicalization_min_speed_mps"
         value="$(arg orientation_canonicalization_min_speed_mps)"/>
  <param name="configure/orientation_flip_enter_error_deg"
         value="$(arg orientation_flip_enter_error_deg)"/>
  <param name="configure/orientation_flip_exit_error_deg"
         value="$(arg orientation_flip_exit_error_deg)"/>
  <param name="configure/compensate_output_to_current_time"
         value="$(arg compensate_output_to_current_time)"/>
  <param name="configure/hold_unknown_output_pose"
         value="$(arg hold_unknown_output_pose)"/>
  <param name="configure/stationary_unknown_prediction"
         value="$(arg stationary_unknown_prediction)"/>
  <param name="configure/maximum_output_compensation_sec"
         value="$(arg maximum_output_compensation_sec)"/>
  <param name="configure/fixed_output_rate_hz"
         value="$(arg fixed_output_rate_hz)"/>
  <param name="configure/maximum_fixed_output_prediction_age_sec"
         value="$(arg maximum_fixed_output_prediction_age_sec)"/>
  <param name="configure/detection_velocity_fusion_mode"
         value="$(arg detection_velocity_fusion_mode)"/>
  <param name="configure/detection_velocity_noise_std_mps"
         value="$(arg detection_velocity_noise_std_mps)"/>
  <param name="configure/detection_velocity_update_max_track_age_sec"
         value="$(arg detection_velocity_update_max_track_age_sec)"/>
  <param name="configure/detection_velocity_maximum_output_age_sec"
         value="$(arg detection_velocity_maximum_output_age_sec)"/>
  <param name="configure/detection_velocity_max_longitudinal_innovation_mps"
         value="$(arg detection_velocity_max_longitudinal_innovation_mps)"/>
  <param name="configure/detection_velocity_longitudinal_blend"
         value="$(arg detection_velocity_longitudinal_blend)"/>
  <param name="configure/center_motion_velocity_fusion"
         value="$(arg center_motion_velocity_fusion)"/>
  <param name="configure/publish_center_motion_diagnostics"
         value="$(arg publish_center_motion_diagnostics)"/>
  <param name="configure/center_motion_fuse_ekf_state"
         value="$(arg center_motion_fuse_ekf_state)"/>
  <param name="configure/center_motion_override_output_velocity"
         value="$(arg center_motion_override_output_velocity)"/>
  <param name="configure/center_motion_maximum_output_age_sec"
         value="$(arg center_motion_maximum_output_age_sec)"/>
  <param name="configure/center_motion_min_baseline_sec"
         value="$(arg center_motion_min_baseline_sec)"/>
  <param name="configure/center_motion_medium_baseline_sec"
         value="$(arg center_motion_medium_baseline_sec)"/>
  <param name="configure/center_motion_long_baseline_sec"
         value="$(arg center_motion_long_baseline_sec)"/>
  <param name="configure/center_motion_max_gap_sec"
         value="$(arg center_motion_max_gap_sec)"/>
  <param name="configure/center_motion_min_update_interval_sec"
         value="$(arg center_motion_min_update_interval_sec)"/>
  <param name="configure/center_motion_max_fit_residual_m"
         value="$(arg center_motion_max_fit_residual_m)"/>
  <param name="configure/center_motion_early_noise_std_mps"
         value="$(arg center_motion_early_noise_std_mps)"/>
  <param name="configure/center_motion_mature_noise_std_mps"
         value="$(arg center_motion_mature_noise_std_mps)"/>
  <param name="configure/prediction_model" value="$(arg prediction_model)"/>
  <param name="configure/shape_consistent_association_ranking"
         value="$(arg shape_consistent_association_ranking)"/>
  <param name="configure/guard_inconsistent_class_transitions"
         value="$(arg guard_inconsistent_class_transitions)"/>
  <param name="configure/system_noise_std_vx_vy_ms"
         value="$(arg system_noise_std_vx_vy_ms)"/>
  <param name="configure/meas_noise_std_xy_m"
         value="$(arg meas_noise_std_xy_m)"/>
  <param name="configure/meas_noise_std_yaw_deg"
         value="$(arg meas_noise_std_yaw_deg)"/>
  <param name="configure/use_kinematic_model"
         value="$(arg use_kinematic_model)"/>
  <param name="use_sim_time" value="$(arg use_sim_time)" />
  <param name="configure/time_aware_track_lifecycle"
         value="$(arg time_aware_track_lifecycle)"/>
  <param name="configure/confirmed_track_max_coast_time_sec"
         value="$(arg confirmed_track_max_coast_time_sec)"/>
  <param name="configure/confirmed_stationary_track_max_coast_time_sec"
         value="$(arg confirmed_stationary_track_max_coast_time_sec)"/>
  <param name="configure/lifecycle_stationary_speed_threshold_mps"
         value="$(arg lifecycle_stationary_speed_threshold_mps)"/>
  <param name="configure/suppress_duplicate_track_birth"
         value="$(arg suppress_duplicate_track_birth)"/>
  <param name="configure/duplicate_birth_suppression_distance_m"
         value="$(arg duplicate_birth_suppression_distance_m)"/>
  <param name="configure/duplicate_birth_minimum_max_dimension_m"
         value="$(arg duplicate_birth_minimum_max_dimension_m)"/>
  <param name="configure/duplicate_birth_maximum_dimension_ratio"
         value="$(arg duplicate_birth_maximum_dimension_ratio)"/>
  <node pkg="ekf_multi_object_tracking"
        type="ekf_multi_object_tracking"
        name="ekf_multi_object_tracking"
        output="screen"
        respawn="false">
    <param name="world_frame_id" value="$(arg world_frame_id)"/>
    <param name="publish_association_diagnostics" value="$(arg publish_association_diagnostics)"/>
    <param name="diagnostics_auto_on_subscribe" value="$(arg diagnostics_auto_on_subscribe)"/>
    <remap from="~input/objects" to="$(arg input_objects)"/>
    <remap from="~output/objects" to="$(arg output_objects)"/>
    <remap from="~diagnostics/association" to="$(arg association_diagnostics_topic)"/>
    <remap from="~diagnostics/center_motion_active_objects"
           to="$(arg center_motion_active_objects)"/>
    <remap from="~diagnostics/center_motion_inactive_objects"
           to="$(arg center_motion_inactive_objects)"/>
  </node>
</launch>
